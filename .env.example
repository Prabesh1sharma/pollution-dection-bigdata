# Copy to .env and adjust to your machine.

# Conservative Spark resources for an 8 GB development machine.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1500m
TRAIN_CORES=2
TRAIN_EXECUTOR_MEMORY=800m
STREAM_CORES=1
DATA_ROW_STRIDE=10          # upload roughly 10% of CSV rows to HDFS (1 = all)

# Producer
POLL_INTERVAL_SECONDS=300
BACKFILL_DAYS=7        # hourly history loaded on producer start (0 = disable, max ~92)

# Only used by the Kaggle download command in the README
KAGGLE_USERNAME=
KAGGLE_KEY=
