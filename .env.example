# Copy to .env and adjust to your machine.

# Spark worker size (the worker needs >= TRAIN_CORES + STREAM_CORES to run both jobs at once)
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=5g
TRAIN_CORES=2
TRAIN_EXECUTOR_MEMORY=2g
STREAM_CORES=2

# Producer
POLL_INTERVAL_SECONDS=300
BACKFILL_DAYS=7        # hourly history loaded on producer start (0 = disable, max ~92)

# Only used by the Kaggle download command in the README
KAGGLE_USERNAME=
KAGGLE_KEY=
